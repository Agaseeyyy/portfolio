{
  "name": "portfolio-v2",
  "version": "1.0.0",
  "description": "Portfolio Admin Panel",
  "scripts": {
    "build:admin": "npx @tailwindcss/cli -i ./resources/css/admin.css -o ./resources/css/admin-compiled.css",
    "watch:admin": "npx @tailwindcss/cli -i ./resources/css/admin.css -o ./resources/css/admin-compiled.css --watch",
    "build": "npm run build:admin",
    "dev": "npm run watch:admin"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "daisyui": "^5.0.0"
  }
}