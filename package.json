{
  "name": "portfolio-v2",
  "version": "1.0.0",
  "description": "Portfolio Admin Panel",
  "scripts": {
    "build:admin": "npx @tailwindcss/cli -i ./resources/css/admin.css -o ./resources/css/admin-compiled.css",
    "watch:admin": "npx @tailwindcss/cli -i ./resources/css/admin.css -o ./resources/css/admin-compiled.css --watch",
    "build:public": "npx @tailwindcss/cli -i ./resources/css/public.css -o ./resources/css/public-compiled.css",
    "watch:public": "npx @tailwindcss/cli -i ./resources/css/public.css -o ./resources/css/public-compiled.css --watch",
    "build": "npm run build:admin && npm run build:public",
    "dev": "npm run watch:admin && npm run watch:public"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "daisyui": "^5.0.0",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "nes.css": "^2.2.1"
  }
}
