# Environment Configuration
# Copy this file to .env and update values for your environment

# Application Settings
APP_NAME="Portfolio"
APP_ENV=local                    # Options: local, production
APP_DEBUG=true                   # Set to false in production (hides errors)
APP_URL=https://agassibustarga.page.gd
APP_PATH=/portfolio              # Set to empty string for production root deployment

# Database Settings
DB_HOST=localhost
DB_NAME=bustarga_portfolio_web
DB_USER=root
DB_PASS=

# Admin Login Credentials
ADMIN_USER=admin
ADMIN_PASS=admin123

# Default Assets
DEFAULT_AVATAR=images/def-avatar.png
HOVER_AVATAR=images/hover-avatar.png

# ============================================
# PRODUCTION SETTINGS EXAMPLE:
# ============================================
# APP_ENV=production
# APP_DEBUG=false
# APP_PATH=
# DB_HOST=your-production-host
# DB_NAME=your-production-db
# DB_USER=your-production-user
# DB_PASS=your-secure-password
# ADMIN_USER=your-admin-username
# ADMIN_PASS=your-secure-admin-password

